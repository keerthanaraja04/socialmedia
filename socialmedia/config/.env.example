# ==============================================================================
# Incubrix Engine Environment Configuration
# ==============================================================================
# WARNING: NEVER commit your actual .env file or hardcode API keys!
# Copy this file to .env in the project root and fill in your actual credentials.
# ==============================================================================

# Required: Official Groq API Key (used for Whisper-large-v3 and LLaMA-3 models)
# Obtain from: https://console.groq.com/keys
GROQ_API_KEY=gsk_your_actual_groq_api_key_here

# Required: Pixabay API Key (used for b-roll stock images and video retrieval)
# Obtain from: https://pixabay.com/api/docs/
PIXABAY_API_KEY=your_actual_pixabay_api_key_here

# Optional: Groq LLM model name for generation & brandcheck
# Supported Groq models: llama-3.3-70b-versatile, llama-3.1-70b-versatile, llama3-70b-8192, mixtral-8x7b-32768
GROQ_LLM_MODEL=llama-3.3-70b-versatile

# Optional: Groq Whisper model name for audio/video transcription
GROQ_WHISPER_MODEL=whisper-large-v3

# Optional: Logging configuration (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO
